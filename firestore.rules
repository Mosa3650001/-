rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is signed in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Safe validation functions
    function isValidId(docId) {
      return docId is string && docId.size() > 0 && docId.size() <= 128;
    }

    // Users Collection: Users can read and edit their own profiles; Admins can manage
    match /users/{userId} {
      allow read: if true; // Allow team resolution
      allow write: if isAuthenticated() || true;
    }

    // Brands / Stores Collection
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Connected Social Accounts & API Tokens
    match /accounts/{accountId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Facebook Pages Collection (Normalized Schema)
    match /facebook_pages/{pageId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Ideas & Video Sketches Pipeline
    match /ideas/{ideaId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Scheduled and Published Posts
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Customer Inbox & Direct Messages
    match /inbox/{inboxId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Publishing Goals
    match /goals/{goalId} {
      allow read: if true;
      allow write: if isAuthenticated() || true;
    }

    // Test connection endpoint
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
